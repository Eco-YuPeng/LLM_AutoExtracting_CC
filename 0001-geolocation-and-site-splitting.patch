+def load_station_registry(path: Path = DEFAULT_STATION_REGISTRY_PATH) -> list[dict]:
+    """
+    Load the manually-curated station registry into plain dicts:
+    {"key": <canonical name>, "names": [name, *aliases],
+     "geometry": <shapely geometry>, "precision_tier": "S"|"A",
+     "boundary_source": <free text>}.
+
+    Expected registry columns (once stations.gpkg exists): name, aliases
+    (";"-separated string), precision_tier, boundary_source, geometry.
+    Returns [] if the file doesn't exist yet — this is the expected state
+    until the registry is built (confirmed 2026-09-11), not an error.
+    """
+    if not Path(path).exists():
+        return []
+    import geopandas as gpd  # local import: only needed when the file exists
+
+    gdf = gpd.read_file(path)
+    entries = []
+    for _, row in gdf.iterrows():
+        aliases = [a.strip() for a in str(row.get("aliases") or "").split(";") if a.strip()]
+        entries.append({
+            "key": row["name"],
+            "names": [row["name"], *aliases],
+            "geometry": row.geometry,
+            "precision_tier": row.get("precision_tier") or "S",
+            "boundary_source": row.get("boundary_source") or "",
+        })
+    return entries
+
+
+def load_csb(csb_path: Path = DEFAULT_CSB_PATH, year: Optional[int] = None) -> list[dict]:
+    """
+    Load USDA Crop Sequence Boundaries field polygons into plain dicts:
+    {"field_id": ..., "geometry": <shapely geometry>}.
