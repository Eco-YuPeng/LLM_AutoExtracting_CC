@@ -0,0 +1,298 @@
+"""
+geolocation.py — Stage 4 of the ground-truth workflow
+(claude/cc-groundtruth-workflow-v0.md, "Geolocation: point -> polygon,
+tiered"). Run ONCE over the harmonized, de-duplicated site list (station
+reuse across papers is high — see AGENTS-level discussion 2026-09-11), not
+per-paper inside the LLM extraction pipeline. literature_extractor.py stays
+point-only (latitude/longitude); this module is a separate downstream step
+that upgrades a site's geometry from a point to a polygon where possible.
+
+Decision (confirmed 2026-09-11): for each unique site, try in order —
+
+  1. Station registry match — the site's raw station/farm name (as printed
+     in the paper) matched against a manually-curated registry of
+     name + aliases + polygon, built by hand in QGIS/Google Earth
+     (`stations.gpkg`, not yet created as of 2026-09-11 — this module
+     degrades gracefully to an empty registry until it exists).
+     -> geom_source="station", spatial_tier = the registry entry's own
+        precision_tier ("S" = farm-envelope-only polygon, the common case;
+        "A" if that entry was itself built from a NAIP-verified plot
+        boundary rather than just the farm outline).
+  2. USDA Crop Sequence Boundaries (CSB) point-in-polygon, by year.
+     Path confirmed 2026-09-11: /home/pengyuwh/Crop Sequence Boundaries
+     on the CyVerse Data Store (exact .gdb filename/layer TBD — see
+     load_csb()'s docstring).
+     -> geom_source="csb", spatial_tier="C" (field-level polygon; this
+        code does NOT infer that a treatment covered the whole field, so
+        it never auto-assigns tier "B" — promote C -> B by hand once a
+        human confirms field-wide treatment).
+  3. Neither resolves -> geom_source="none", spatial_tier="D". The site
+     is returned in the manual-review queue for later NAIP delineation
+     (confirmed fallback, 2026-09-11) — this module never guesses a
+     geometry for it.
+
+geom_source values (paper_map/naip_manual/csb/station/none) and spatial
+tiers (A/B/C/S/D) match the target schema already drafted in
+claude/cc-groundtruth-workflow-v0.md — "paper_map" and "naip_manual" are
+produced by the human-review steps elsewhere in that pipeline, not by this
+module.
+
+Design note: matching logic here (match_station_name, match_csb_polygon,
+resolve_site_geometry) works on plain dicts + shapely geometries, NOT
+GeoDataFrames — geopandas/fiona are only imported inside the two loader
+functions (load_station_registry, load_csb), which are the I/O boundary.
+This keeps the matching logic unit-testable without geopandas/fiona
+installed (see tests/test_geolocation.py), since only shapely is a hard
+dependency of the matching itself.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Optional
+
+# CyVerse Data Store path confirmed 2026-09-11. The exact .gdb file inside
+# this folder and its layer-per-year naming still need to be confirmed
+# against the real data (see load_csb()) — this is a starting point, not
+# yet verified against the live file.
+DEFAULT_CSB_PATH = Path("/home/pengyuwh/Crop Sequence Boundaries")
+
+# Not yet created (2026-09-11) — the user is building this by hand in
+# QGIS/Google Earth. load_station_registry() returns [] until it exists,
+# so every site falls through to CSB / tier D in the meantime.
+DEFAULT_STATION_REGISTRY_PATH = Path(__file__).resolve().parent.parent / "stations.gpkg"
+
+
+@dataclass
+class SiteGeometryResult:
+    geometry_geojson: Optional[str]  # GeoJSON geometry string, or None if unresolved
+    geom_source: str                 # "station" | "csb" | "none"
