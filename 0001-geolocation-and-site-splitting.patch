+"""Unit tests for src/geolocation.py — the point -> polygon tiered
+geolocation stage. All tests use synthetic registry/CSB entries (plain
+dicts + shapely geometries), so no geopandas/fiona/network/real CyVerse
+data is needed."""
+
+import json
+import sys
+from pathlib import Path
+
+from shapely.geometry import Polygon
+
+sys.path.insert(0, str(Path(__file__).parent.parent))
+
+from src.geolocation import (  # noqa: E402
+    match_csb_polygon,
+    match_station_name,
+    resolve_all_sites,
+    resolve_site_geometry,
+)
+
+NDSU_FARM = {
+    "key": "NDSU Horticulture Research Farm",
+    "names": ["NDSU Horticulture Research Farm", "Horticulture Research Farm", "Absaraka Farm"],
+    "geometry": Polygon([(-97.36, 46.98), (-97.34, 46.98), (-97.34, 47.00), (-97.36, 47.00)]),
+    "precision_tier": "S",
+    "boundary_source": "manual QGIS digitize, 2026-09",
+}
+
+MANDAN_FARM = {
+    "key": "USDA-ARS Northern Great Plains Research Lab",
+    "names": ["USDA-ARS Northern Great Plains Research Lab", "Mandan", "West Fargo site"],
+    "geometry": Polygon([(-100.93, 46.80), (-100.91, 46.80), (-100.91, 46.82), (-100.93, 46.82)]),
+    "precision_tier": "A",  # this one was built from a NAIP-verified plot boundary
+    "boundary_source": "NAIP plot delineation, 2026-08",
+}
+
+CSB_FIELD = {
+    "field_id": "CSB123456",
+    "geometry": Polygon([(-100.93, 46.80), (-100.91, 46.80), (-100.91, 46.82), (-100.93, 46.82)]),
+}
+
+
+def test_match_station_name_exact():
+    match = match_station_name("Absaraka Farm", [NDSU_FARM, MANDAN_FARM])
+    assert match["key"] == "NDSU Horticulture Research Farm"
+
+
+def test_match_station_name_substring_either_direction():
+    # paper text is a longer, differently-worded description containing the alias
+    match = match_station_name(
+        "near Mandan, ND (West site)", [NDSU_FARM, MANDAN_FARM]
+    )
+    assert match["key"] == "USDA-ARS Northern Great Plains Research Lab"
+
+
+def test_match_station_name_no_hit_returns_none():
+    assert match_station_name("Some Unrelated University Farm", [NDSU_FARM]) is None
+    assert match_station_name(None, [NDSU_FARM]) is None
+    assert match_station_name("Absaraka Farm", []) is None
+
+
+def test_match_csb_polygon_point_inside():
+    hit = match_csb_polygon(46.81, -100.92, [CSB_FIELD])
+    assert hit["field_id"] == "CSB123456"
+
+
+def test_match_csb_polygon_point_outside_returns_none():
+    assert match_csb_polygon(0.0, 0.0, [CSB_FIELD]) is None
+
+
+def test_resolve_site_geometry_station_registry_hit_uses_its_own_tier():
+    # station registry match wins even when a CSB polygon is ALSO available
+    # at that point (station registry is tried first, per the confirmed order)
+    result = resolve_site_geometry(
+        "near Mandan, ND (West site)", 46.81, -100.92,
+        station_registry=[NDSU_FARM, MANDAN_FARM], csb_entries=[CSB_FIELD],
+    )
+    assert result.geom_source == "station"
+    assert result.spatial_tier == "A"  # MANDAN_FARM's own precision_tier, not a hardcoded "S"
+    assert result.matched_key == "USDA-ARS Northern Great Plains Research Lab"
+    assert json.loads(result.geometry_geojson)["type"] == "Polygon"
+
+
+def test_resolve_site_geometry_falls_back_to_csb_when_no_station_match():
+    result = resolve_site_geometry(
+        "An unregistered farm not in the gazetteer", 46.81, -100.92,
+        station_registry=[NDSU_FARM], csb_entries=[CSB_FIELD],
+    )
+    assert result.geom_source == "csb"
+    assert result.spatial_tier == "C"
+    assert result.matched_key == "CSB123456"
+
+
+def test_resolve_site_geometry_falls_back_to_tier_d_when_nothing_matches():
+    result = resolve_site_geometry(
+        "An unregistered farm", 0.0, 0.0,
+        station_registry=[NDSU_FARM], csb_entries=[CSB_FIELD],
+    )
+    assert result.geom_source == "none"
+    assert result.spatial_tier == "D"
+    assert result.geometry_geojson is None
+
+
+def test_resolve_site_geometry_empty_registry_does_not_crash():
+    # expected state until stations.gpkg is built (2026-09-11) -- must
+    # degrade gracefully rather than raising
+    result = resolve_site_geometry("Any Farm", 46.81, -100.92, station_registry=[], csb_entries=[])
+    assert result.spatial_tier == "D"
+
+
+def test_resolve_all_sites_splits_manual_review_queue():
+    sites = [
+        {"site_key": "s1", "station_name": "Absaraka Farm", "lat": 46.99, "lon": -97.35},
+        {"site_key": "s2", "station_name": "unmatched site", "lat": 0.0, "lon": 0.0},
+    ]
+    resolved, manual_review = resolve_all_sites(
+        sites, station_registry_path=Path("/nonexistent.gpkg"), csb_path=Path("/nonexistent")
+    )
+    assert len(resolved) == 2
+    # registry path doesn't exist (empty registry) and CSB path doesn't exist either,
+    # so BOTH sites fall through to tier D here -- this test is about the split
+    # mechanics, not about station matching (see test_resolve_site_geometry_* for that)
+    assert len(manual_review) == 2
+    assert {r["site_key"] for r in manual_review} == {"s1", "s2"}
+    assert all(r["spatial_tier"] == "D" for r in resolved)
