+def match_station_name(station_name_raw: Optional[str], registry: list[dict]) -> Optional[dict]:
+    """
+    Loose match of a paper's raw station/farm name against the registry's
+    name + aliases: exact match after normalization wins immediately;
+    otherwise the longest substring match either direction (station names
+    in papers are often abbreviated, reordered, or missing "Research" /
+    "Farm" — e.g. "NDSU Horticulture Farm" vs the registry's "Horticulture
