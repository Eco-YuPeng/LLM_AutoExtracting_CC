# Generated per-paper intermediate files — large, reproducible, not for
# version control. The final extracted table (workflows/*/output/*.csv
# or .xlsx) is NOT ignored — that's the actual deliverable.
**/output/*.md
**/_page_cache/     # rendered page images used for vision_llm calls (step 7)

# Python
__pycache__/
**/__pycache__/
*.pyc

# macOS
.DS_Store

# Editors
.vscode/
.idea/
.Rhistory

# Copyrighted source PDFs for gold-eval papers — local only, never push to GitHub
ground_truth/pdfs/

# Raw source spreadsheets (GHG.xlsx, YieldTable.xlsx) -- Yu Peng's own
# curated data, kept locally in the working tree (scripts default to
# reading from here, see ground_truth/README.md) but not pushed to
# GitHub, even though this repo is private (2026-09-15).
ground_truth/source_data/

# Ad hoc / scratch outputs from one-off scoring runs and commit-message
# drafts -- reproducible, not deliverables, accidentally committed once
# (2026-09-15 cleanup).
.commit_msg*.txt
ground_truth/output/scoring_run_*/
ground_truth/output/*_available11.csv
